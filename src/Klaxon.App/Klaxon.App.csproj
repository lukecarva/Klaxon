<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Klaxon.Core\Klaxon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.Screen: enumerating monitors and working
         areas. Doing it by hand with EnumDisplayMonitors would be far more code
         for the same result. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Klaxon</AssemblyName>
    <RootNamespace>Klaxon.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness (PerMonitorV2) for sharp alerts on mixed-scale
         multi-monitor setups. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 asks to set DPI via the WinForms API; this is a WPF app that uses
         WinForms only to enumerate screens (no message loop), so the manifest is
         the mechanism that actually applies. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!-- Runtime footprint tuning. A tray utility wants the smallest possible
       working set, not maximum throughput. -->
  <PropertyGroup>
    <!-- Workstation GC, not server: a single heap, without one GC thread per
         core. For a small, always-open app it uses far less memory. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No concurrent GC: drops the background thread and the extra heap it
         reserves. GC pauses are irrelevant in an alarm clock. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Return memory to the OS instead of holding it for reuse — trades a little
         reallocation speed for a smaller working set at rest. -->
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must be a Resource (not just ApplicationIcon) so the tray icon's pack://
         URI resolves at runtime. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms to the implicit usings, which
         makes Application, MessageBox and friends ambiguous with the WPF ones. The
         few WinForms types we use (Screen) are qualified by hand. -->
    <Using Remove="System.Windows.Forms" />
    <!-- Same reason: System.Drawing.Brush/Color/Point collide with the WPF ones. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
